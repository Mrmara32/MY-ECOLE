# Copiez ce fichier en .env et modifiez les valeurs si besoin

PORT=3000

# Clé secrète JWT (signature des connexions). Laisser VIDE : un secret aléatoire propre
# à cette installation est alors créé automatiquement (data/cle_jwt_locale.txt).
# Sur un serveur, la renseigner avec une longue chaîne aléatoire.
JWT_SECRET=

# Compte administrateur initial (créé au premier lancement uniquement)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@2025!

# --- Sauvegarde automatique HORS serveur (chiffrée) : voir sauvegarde_externe.py ---
# GS_S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# GS_S3_REGION=us-west-004
# GS_S3_BUCKET=mon-seau
# GS_S3_KEY_ID=
# GS_S3_SECRET=
# GS_BACKUP_CLE=mot-de-passe-de-chiffrement-a-noter-ailleurs

# --- E-mails par l'API Brevo (recommandé : pas de port SMTP à ouvrir) ---
# BREVO_API_KEY=xkeysib-...
# EMAIL_EXPEDITEUR=adresse validée dans Brevo → Expéditeurs
# EMAIL_EXPEDITEUR_NOM=MY-ECOLE
